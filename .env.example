# ============================================================
#  Unified AI Health & Fitness Coach — environment template
#  Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================

# --- WHOOP Cloud API (Adapter A) ----------------------------
# Get these at https://developer.whoop.com
# Create an app, set the redirect URI below, copy the credentials.
# Requires an ACTIVE WHOOP membership.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8080/callback

# --- MyFitnessPal food diary (Adapter A) --------------------
# Direct v2-API ingest of YOUR OWN diary, authenticated with your
# browser session cookie. Log in at myfitnesspal.com, open devtools
# -> Network, copy the full `Cookie:` request header from any request
# to myfitnesspal.com, and paste it below (one line, keep the quotes
# off). Lasts ~weeks; re-copy it when `coach ingest mfp` returns 401.
# NOTE: this uses MFP's private API — a deliberate, signed-off override
# of the original "do not scrape MFP" rule, for your own account only.
# See docs/adr/0010-override-mfp-scraping-ban.md.
MFP_SESSION_COOKIE=

# --- Coach LLM provider -------------------------------------
# Which provider `coach ask` / `coach eval grounding` talks to.
#   google    — Gemini, has a real FREE TIER (default)
#   anthropic — Claude, pay-as-you-go
#   grok      — xAI Grok, pay-as-you-go
COACH_LLM_PROVIDER=google

# Google AI Studio key — free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Anthropic key — https://console.anthropic.com (pay-as-you-go).
# NOTE: SEPARATE from a Claude.ai subscription; a Pro/Max plan does
# NOT grant API access.
ANTHROPIC_API_KEY=

# xAI key — https://console.x.ai (pay-as-you-go).
XAI_API_KEY=

# Override the model. Leave EMPTY to use the provider's default
# (google: gemini-3.6-flash · anthropic: claude-sonnet-5 · grok: grok-4.20-0309-non-reasoning).
# Model names change over time — set this if the default 404s.
COACH_MODEL=

# --- Local storage ------------------------------------------
# SQLite file location. Relative paths resolve from the repo root.
COACH_DB_PATH=./data/coach.db

# --- User context -------------------------------------------
# Single-user app; user_id is always 1 (multi-tenancy insurance).
COACH_USER_ID=1

# IANA timezone name for the user's HOME timezone.
# Per-record timezones are captured at ingest; this is only the
# fallback when a source doesn't report one.
COACH_HOME_TZ=America/New_York

# Unit system for display: metric | imperial
COACH_UNITS=metric

# --- Logging ------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
COACH_LOG_LEVEL=INFO
